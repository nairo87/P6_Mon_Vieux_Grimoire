# Renommez ce fichier en .env et complétez les valeurs

# URI de connexion à votre cluster MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/monvieuxgrimoire?retryWrites=true&w=majority

# Clé secrète utilisée pour signer les tokens JWT (mettez une longue chaîne aléatoire)
JWT_SECRET=changez_moi_avec_une_chaine_secrete_longue_et_aleatoire

# Port sur lequel le serveur Express écoute
PORT=4000
